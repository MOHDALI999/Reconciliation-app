{
    "version": 2,
    "builds": [
      {
        "src": "server/server.cjs",
        "use": "@vercel/node",
        "config": {
          "includeFiles": [
            "server/core/**",
            "server/worker/**",
            "server/**/*.cjs",
            "vendor/**"
          ]
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "server/server.cjs"
      }
    ]
  }